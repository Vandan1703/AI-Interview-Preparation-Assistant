# Select the implementation in app/services/providers/factory.py
LLM_PROVIDER=gemini

# Obtain this from Google AI Studio. Never commit the real key.
GEMINI_API_KEY=replace_me-lite
# Use Google's supported rolling Flash alias. Pin a version only when it is
# confirmed available to the project behind your API key.
GEMINI_MODEL=gemini-flash-latest

# Keep the coaching responses consistent and concise.
LLM_TEMPERATURE=0.2
# Fail promptly on provider errors instead of retrying a seven-agent workflow.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LOG_LEVEL=INFO
